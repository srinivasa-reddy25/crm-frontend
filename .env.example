# Copy this file to .env.local for local development.
# NEXT_PUBLIC_* values are included in the browser bundle. Never put backend
# credentials (OpenAI keys or Firebase service-account keys) in this file.

# Backend origin, without /api or a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: https://crm-backend-recovered.onrender.com

# Firebase web app configuration (Firebase Console > Project settings).
# Use the same Firebase project as the backend service account.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGEBUCKET=your-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGE_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APPID=your-firebase-web-app-id
# Optional: Firebase Analytics measurement ID.
NEXT_PUBLIC_FIREBASE_MEASURE_ID=

# Production Google redirect login uses the frontend's own domain:
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=crm-frontend-taupe-six.vercel.app
# Authorize that domain in Firebase Authentication. The /__/auth and /__/firebase
# rewrites in next.config.mjs must target your Firebase project's firebaseapp.com
# domain (currently crm-old-2609c.firebaseapp.com).

# Optional React Query devtools, shown only during development.
NEXT_PUBLIC_SHOW_DEVTOOLS=false
# Next.js sets NODE_ENV automatically for dev/build/start; do not override it.
